# Local CLI/setup values. Copy to .env.local; replace placeholders.
# Use this product's own provider environment, never CompanyNerve/suite values.
# WorkOS methods: Magic Auth email codes + Google only; email/password disabled.
# Google OAuth credentials belong in this product's WorkOS configuration.
CONVEX_DEPLOYMENT=
# Backend-only media configuration, set on the matching Convex deployment.
# MEDIA_VERIFIED=false
# CLOUD_SANDBOX_PROVIDER=vercel
# VERCEL_MEDIA_SNAPSHOT=pinned_verified_media_snapshot
# VERCEL_CODING_SNAPSHOT=pinned_verified_coding_snapshot
# CLOUD_VERIFIED=false
# ACQUISITION_VERIFIED=false
# LINK_PREVIEWS_ENABLED=false
# Direct source release gates, backend-only and default off. No local setting
# activates a hosted provider. Review ADR 117 and reserve live checks first.
# DIRECT_SOURCES_ENABLED=false
# GITHUB_SOURCES_ENABLED=false
# REDDIT_SOURCES_ENABLED=false
# Creator intake and service inference remain independently default off.
# Never set these from an example without provider/rights/cost review.
# CREATOR_FOLLOWING_ENABLED=false
# CREATOR_DISCOVERY_CRON_ENABLED=false
# CREATOR_PROVIDER_CONFIGURATION=operator_reviewed_versioned_json
# CREATOR_SERVICE_REUSE_ENABLED=false
# CREATOR_SERVICE_ORGANIZATION_ID=operator_reviewed_service_workspace
# ORDERED_MEDIA_VERIFIED=false
# APIFY_TOKEN belongs only in the protected backend provider configuration.
# Reddit additionally requires current REDDIT_SOURCE_ELIGIBILITY_JSON and its
# dedicated REDDIT_SOURCE_OAUTH_TOKEN. Never put the real token in this file.
# SANDBOX_BRIDGE_URL=https://your-public-domain/api/internal/sandbox-credentials
# SANDBOX_BRIDGE_SECRET=generated_256_bit_shared_secret
# SANDBOX_BRIDGE_ENABLED=false
# VERCEL_SANDBOX_TEAM_ID=dedicated_team
# VERCEL_SANDBOX_PROJECT_ID=dedicated_project
# SANDBOX_CREDITS_PER_SECOND=verified_compute_rate
# Vercel Production only: SANDBOX_TEAM_ID, SANDBOX_PROJECT_ID,
# SANDBOX_BRIDGE_SECRET and SANDBOX_BRIDGE_ENABLED. Never use NEXT_PUBLIC_.
NEXT_PUBLIC_CONVEX_URL=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Stripe settings belong in the matching Convex deployment, not the browser.
# STRIPE_ACCOUNT_ID=acct_expected_dedicated_vibescroller_account
# STRIPE_MODE=test
# STRIPE_BILLING_ROUTE=managed_payments
# STRIPE_MANAGED_PAYMENTS_VERIFIED=false
# STRIPE_MANAGED_MARKET=tax_covered
# STRIPE_MANAGED_COUNTRY_RULE_PROOF=operator_verified_account_mode_policy_record
# LIVE_CHECKOUT_ENABLED=false
# BILLING_RELEASE_APPROVED=false
# Explicit verified WorkOS subjects for company invoice operators, never emails.
# Default [] grants no reporting-write or global invoice-queue access.
INVOICE_OPERATOR_SUBJECTS_JSON=[]
# Reviewed metered Google route, server-side only. Public release is separate.
# MANAGED_INFERENCE_ROUTE=google_metered
# GOOGLE_INFERENCE_ENABLED=false
# GOOGLE_INFERENCE_COST_POLICY=google-eu-standard-2026-10-03-v1
# GOOGLE_INFERENCE_REVIEW_EXPIRES_AT=reviewed_expiry_timestamp
# GOOGLE_INFERENCE_BRIDGE_SECRET=generated_256_bit_shared_secret
# GOOGLE_INFERENCE_BRIDGE_URL=https://your-app.example.invalid/api/internal/inference
# Vercel production only: GOOGLE_INFERENCE_PROJECT_ID, GOOGLE_INFERENCE_PROJECT_NUMBER,
# GOOGLE_INFERENCE_ENABLED, GOOGLE_INFERENCE_COST_POLICY, GOOGLE_INFERENCE_REVIEW_EXPIRES_AT,
# GOOGLE_INFERENCE_BRIDGE_SECRET. Use OIDC; no Google service-account key.
