# Use this product's own WorkOS environment; never inherit suite credentials.
# In WorkOS: enable Magic Auth email codes + Google, disable email/password
# and all other sign-in methods. Environment values do not apply that policy.
# Store this product's Google OAuth client credentials in WorkOS, not here.
NEXT_PUBLIC_CONVEX_URL=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Session encryption secret (32+ random characters), not a user login password.
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3001/callback
APP_URL=http://localhost:3001

# Optional LaunchProof summary, server only. See docs/operations/launchproof.md.
# Each exported product supplies its own explicit mapping and summary-only token.
LP_INTEGRATION_ENABLED=false
LP_INTEGRATION_ORIGIN=https://launch.companynerve.com
LP_INTEGRATION_APPLICATION_ID=
LP_INTEGRATION_WORKSPACE_SLUG=
LP_INTEGRATION_TARGET_ORGANIZATION_ID=
LP_INTEGRATION_TARGET_ORIGIN=
LP_INTEGRATION_ENVIRONMENT_ID=
LP_INTEGRATION_SUMMARY_TOKEN=
LP_INTEGRATION_CACHE_TTL_MS=60000
LP_INTEGRATION_TIMEOUT_MS=3000
# Immutable identity of the deployed TARGET BACKEND that checks actually exercise.
# Do not automatically use the frontend deployment ID or a branch name.
LP_INTEGRATION_CURRENT_COMMIT=
LP_INTEGRATION_CURRENT_DEPLOYMENT_ID=
# Advertise text execution tools only with the matching reviewed backend gate.
WORK_CLOUD_TEXT_ENABLED=false
WORK_CLOUD_TEXT_VERIFIED=false
