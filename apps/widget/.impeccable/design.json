  "narrative": {
    "northStar": "Library desk",
    "overview": "This document governs `apps/widget` only. The approved Operate direction combines A's Library desk, B's inline cited cards and C's project review. Quiet neutral panels keep a saved claim, its current source evidence and its next action close together. The host supplies the sans-serif family and theme. The widget adds compact controls, line-based structure and restrained mint status accents.\n\nThe widget is a working view inside ChatGPT or Codex. Its design authority is `APPROVED-DIRECTION.md`; the website's Atlas and marketing systems remain separate. Extraction uses `src/style.css`, `src/app.tsx`, `src/components.tsx` and `src/host.tsx`, checked against the six current images in the repository's `.impeccable/review` directory. `finish-review.md` records ship for three scored corrections only. Those images are illustrative DEV fixtures, not live host or production acceptance.",
    "keyCharacteristics": [
      "Evidence stays beside the selected claim on wide screens.",
      "Native controls and semantic Lucide icons carry the actions.",
      "Project stages and authoritative receipts describe recorded state.",
      "Light and dark appearance follow the host."
    ],
    "rules": [
      {
        "name": "The Semantic Mint Rule",
        "body": "Use mint for evidence and recorded state. Primary actions use reversed ink and canvas.",
        "section": "colors"
      },
      {
        "name": "The Readable Claim Rule",
        "body": "Preserve complete claim and source wording. Let text wrap and the container grow.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Use tone and borders for persistent panels. Reserve the recorded shadow for transient notifications.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use host-native type and host-provided theme changes.",
      "Do keep the complete claim, source evidence and explicit next action together.",
      "Do preserve native keyboard controls, labelled fields, visible focus and route focus recovery.",
      "Do retain authoritative receipts, current source versions and explicit recovery text.",
      "Do distinguish fixture review from live host and production acceptance.",
      "Do reuse the existing original brand asset where an icon asset is required. No raster artwork ships in this widget build."
    ],
    "donts": [
      "Don't import the website's palette, custom fonts or marketing composition into this widget.",
      "Don't invent whole-library counts, progress percentages or measured-benefit claims.",
      "Don't treat selection, draft preparation or review as execution approval.",
      "Don't add application navigation to inline cited cards.",
      "Don't infer complete accessibility or host acceptance from the six fixture screenshots."
    ]
  }
}
