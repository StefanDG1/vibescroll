{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scroll.companynerve.com/contracts/source-insight-v2.schema.json",
  "title": "Cited non-media source insight output v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceId",
    "processingRunId",
    "coverage",
    "summary",
    "insights",
    "warnings",
    "sourceRevisionId",
    "sourceContentHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "processingRunId": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "const": "source_text"
    },
    "summary": {
      "type": "string",
      "maxLength": 1500
    },
    "warnings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "insights": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "claim",
          "interpretation",
          "categories",
          "evidence",
          "confidence",
          "verificationNeeds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "claim": {
            "type": "string",
            "maxLength": 2000
          },
          "interpretation": {
            "type": "string",
            "maxLength": 2000
          },
          "categories": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "enum": [
                "coding",
                "ai",
                "video_editing",
                "sales",
                "business_operations",
                "marketing",
                "product_design",
                "general_advice",
                "other"
              ]
            }
          },
          "topics": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 48
            }
          },
          "evidence": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "id", "startMs", "endMs"],
              "properties": {
                "kind": {
                  "enum": [
                    "github_file",
                    "reddit_post",
                    "reddit_comment",
                    "supplied_text"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "startMs": {
                  "const": null
                },
                "endMs": {
                  "const": null
                }
              }
            }
          },
          "confidence": {
            "enum": ["supported", "uncertain", "unsupported"]
          },
          "verificationNeeds": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 500
            }
          },
          "icon": {
            "enum": [
              "lightbulb",
              "compass",
              "checklist",
              "code",
              "chart",
              "megaphone",
              "users",
              "palette",
              "shield",
              "workflow",
              "book",
              "heart",
              "wrench"
            ]
          }
        }
      }
    },
    "sourceRevisionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "sourceContentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
